# ------------------------------------------------------------------
# Environment variables for the order notifier (api/notify-order.js)
#
# Local development:  copy this file to `.env.local` and fill it in,
#                     then run `vercel dev`.
# Production:         add the same two variables in the Vercel dashboard
#                     (Settings -> Environment Variables) and redeploy.
#
# Rotate the bot token in @BotFather first — the old one was previously
# exposed in client-side JavaScript.
# ------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------
# AI shopping assistant (api/chat.js) — works with a FREE key.
# Full step-by-step guide: instruction.txt
#
# Easiest free option: Google Gemini. Get a key at
#   https://aistudio.google.com/apikey
# Other free options: Groq (https://console.groq.com/keys) or
# OpenRouter (https://openrouter.ai/keys).
#
# Paste the key below. The provider is detected from the key itself
# (AIza... = Gemini, gsk_... = Groq, sk-or-... = OpenRouter,
#  sk-ant-... = Anthropic).
# ------------------------------------------------------------------
AI_API_KEY=

# Optional: force a provider — gemini | groq | openrouter | anthropic
AI_PROVIDER=

# Optional: override the model name (only if the default ever stops working)
CHAT_MODEL=

# Optional: your public domain, used in sitemap.xml and canonical URLs.
SITE_URL=https://jannatbakingtools.vercel.app
